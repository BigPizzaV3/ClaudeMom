{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClaudeMom",
  "version": "0.1.0",
  "identifier": "com.bigpizzav3.claudemom",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "beforeBuildCommand": "npm run vite:build",
    "devUrl": "http://127.0.0.1:1440",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClaudeMom",
        "width": 860,
        "height": 600,
        "minWidth": 720,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2Njk1OTQ1M0E5RTFEQkYKUldTL0haNDZSVmxwSm9zdmdJVG4rWFFVQitMUGRZSmVVVW5VYThweU1KYzNlUlRWVllpeUFYY2gK",
      "endpoints": [
        "https://github.com/BigPizzaV3/ClaudeMom/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
