{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClaudeMom",
  "version": "0.1.0",
  "identifier": "com.bigpizzav3.claudemom",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "beforeBuildCommand": "npm run vite:build",
    "devUrl": "http://127.0.0.1:1440",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClaudeMom",
        "width": 860,
        "height": 600,
        "minWidth": 720,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
